---
import MainGridLayout from "../layouts/MainGridLayout.astro";
---
<MainGridLayout title="404" description="页面不存在">
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-9 py-12 relative w-full flex flex-col items-center justify-center text-center gap-4">
			<div class="text-6xl font-bold text-[var(--primary)]">404</div>
			<p class="text-50">这一页不存在，或者已经被删掉了。</p>
			<a href="/" class="btn-regular rounded-lg h-10 px-4 text-sm font-medium">回到首页</a>
		</div>
	</div>
</MainGridLayout>
